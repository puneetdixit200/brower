diff --git a/chrome/browser/browseros/buildflags.gni b/chrome/browser/browseros/buildflags.gni
new file mode 100644
index 0000000000000..e9c2702ebc12a
--- /dev/null
+++ b/chrome/browser/browseros/buildflags.gni
@@ -0,0 +1,51 @@
+# Copyright 2024 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+declare_args() {
+  # Product identity to ship this build as. Aster is Linux-only and always
+  # uses its baked identity; runtime product switching is unavailable.
+  browseros_product = "browseros"
+  # Explicitly disabled unless the Python planner selects Aster Linux debug.
+  aster_use_unpacked_dev_extension = false
+}
+
+declare_args() {
+  # Dev/test only for the existing BrowserOS/BrowserClaw products.
+  browseros_allow_runtime_product_override = browseros_product != "aster"
+  # Usually follows runtime override, but can be forced on for packaging tests.
+  # Aster must never package BrowserOS or BrowserClaw server payloads.
+  browseros_package_all_server_resources = browseros_product != "aster"
+}
+
+assert(browseros_product == "browseros" || browseros_product == "browserclaw" ||
+           browseros_product == "aster",
+       "browseros_product must be 'browseros', 'browserclaw', or 'aster'")
+assert(browseros_product != "aster" || target_os == "linux",
+       "Aster is supported only on Linux")
+assert(browseros_product != "aster" || !browseros_allow_runtime_product_override,
+       "Aster cannot use --browseros-product runtime overrides")
+assert(browseros_product != "aster" || !browseros_package_all_server_resources,
+       "Aster cannot package foreign product server resources")
+
+assert(!aster_use_unpacked_dev_extension ||
+           (browseros_product == "aster" && target_os == "linux" &&
+            is_debug && !is_official_build),
+       "Unpacked Aster extensions are allowed only for non-official Linux debug")
+
+browseros_product_browseros = browseros_product == "browseros"
+browseros_product_browserclaw = browseros_product == "browserclaw"
+browseros_product_aster = browseros_product == "aster"
+
+# macOS profile root: substituted into app-Info.plist's CrProductDirName by
+# //chrome:chrome_app. Linux/Windows read the buildflags directly in
+# chrome_paths_linux.cc / chromium_install_modes.h. Changing a value orphans
+# every existing install's profile.
+if (browseros_product_browserclaw) {
+  browseros_product_dir_name = "BrowserClaw"
+} else {
+  browseros_product_dir_name = "BrowserOS"
+}
+if (browseros_product_aster) {
+  browseros_product_dir_name = "Aster"
+}
