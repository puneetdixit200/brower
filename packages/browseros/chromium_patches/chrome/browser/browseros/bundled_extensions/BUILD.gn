diff --git a/chrome/browser/browseros/bundled_extensions/BUILD.gn b/chrome/browser/browseros/bundled_extensions/BUILD.gn
new file mode 100644
index 0000000000000000000000000000000000000000..dcc0720c667865f28b40801cd250c5aadcfe60d1
--- /dev/null
+++ b/chrome/browser/browseros/bundled_extensions/BUILD.gn
@@ -0,0 +1,71 @@
+# Copyright 2024 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//chrome/browser/browseros/buildflags.gni")
+
+# Bundled BrowserOS extensions for immediate installation on first run.
+# These CRX files are installed locally before fetching remote updates.
+#
+# To add a new bundled extension:
+# 1. Add the .crx file to this directory
+# 2. Add an entry to bundled_extensions.json with the extension ID, filename, and version
+# 3. Add the .crx file to the sources list below
+# 4. Ensure the extension's manifest.json has an update_url for future updates
+
+_bundled_extensions_sources = [
+  "bundled_extensions.json",
+  "adlpneommgkgeanpaekgoaolcpncohkf.crx",  # Bug Reporter
+]
+
+if (browseros_product_aster) {
+  # Generated only from an explicitly prepared Aster CRX. Missing Aster
+  # resources must fail GN/build rather than substituting a BrowserOS bundle.
+  _bundled_extensions_sources = [
+    "bundled_extensions.json",
+    "oifdmombnijnaiocijiacjhajbnpdlhb.crx",  # Aster app
+  ]
+}
+
+if (browseros_allow_runtime_product_override || browseros_product_browseros) {
+  _bundled_extensions_sources +=
+      [ "bflpfmnmnokmjhmgnolecpppdbdophmk.crx" ]  # Agent
+}
+
+if (browseros_allow_runtime_product_override || browseros_product_browserclaw) {
+  _bundled_extensions_sources +=
+      [ "pjimfkbpehlcllblajnpfamdfjhhlgkc.crx" ]  # BrowserClaw
+}
+
+if (browseros_product_aster && aster_use_unpacked_dev_extension) {
+  # This import is generated only by the explicitly gated Aster source step.
+  # Missing input fails GN rather than using any foreign signed CRX.
+  import("aster_unpacked_dev_sources.gni")
+  action("bundled_extensions") {
+    script = "stage_aster_unpacked.py"
+    sources = aster_unpacked_dev_sources + [ "bundled_extensions.json" ]
+    outputs = [
+      "$root_out_dir/browseros_extensions/aster_unpacked_dev.stamp",
+      "$root_out_dir/browseros_extensions/bundled_extensions.json",
+    ]
+    foreach(source, aster_unpacked_dev_sources) {
+      outputs += [ "$root_out_dir/browseros_extensions/$source" ]
+    }
+    args = [
+      rebase_path("aster_unpacked_dev", root_build_dir),
+      rebase_path("$root_out_dir/browseros_extensions/aster_unpacked_dev", root_build_dir),
+      rebase_path(outputs[0], root_build_dir),
+    ]
+  }
+} else if (!is_mac) {
+  copy("bundled_extensions") {
+    sources = _bundled_extensions_sources
+    outputs = [ "$root_out_dir/browseros_extensions/{{source_file_part}}" ]
+  }
+} else {
+  # On Mac, bundle data goes into the framework bundle
+  bundle_data("bundled_extensions") {
+    sources = _bundled_extensions_sources
+    outputs = [ "{{bundle_contents_dir}}/Resources/browseros_extensions/{{source_file_part}}" ]
+  }
+}
