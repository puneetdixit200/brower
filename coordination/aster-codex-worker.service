[Unit]
Description=Aster Codex GitHub task worker (single-instance)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/bin/aster-codex-worker.py --repo %h/Projects/aster-browser/upstream-browseros
TimeoutStartSec=0
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
